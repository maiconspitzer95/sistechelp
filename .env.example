# =======================================================
# Sistech Desk — Central de Chamados Internos
# Santa Casa de Pelotas — Configurações de Ambiente
# =======================================================

# Porta única do sistema e IP de escuta
PORT=5002
HOST=0.0.0.0
NODE_ENV=production

# URL do cliente (opcional em produção, pois frontend e backend rodam na mesma porta)
CLIENT_URL=

# Conexão com PostgreSQL (Santa Casa de Pelotas)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=sistech_desk
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_SSL=false

# Segurança e Autenticação JWT
JWT_SECRET=sistech_desk_secret_key_santacasa_2026_super_secure
JWT_EXPIRES_IN=7d

# Diretório e Limites de Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15
